# Copy to /opt/plane-custom/.env and replace every CHANGE_ME value.
# Never commit the real file.
IMAGE_REGISTRY=ghcr.io/antoniorenovato/plane
IMAGE_TAG=sha-0000000000000000000000000000000000000000
WEB_URL=https://plane.grupoccima.com
CORS_ALLOWED_ORIGINS=https://plane.grupoccima.com
SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET
LIVE_SERVER_SECRET_KEY=CHANGE_ME_LONG_RANDOM_LIVE_SECRET
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://plane:CHANGE_ME_POSTGRES_PASSWORD@plane-db:5432/plane
REDIS_URL=redis://plane-redis:6379/
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE_ME_RABBITMQ_PASSWORD@plane-mq:5672/plane
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY
AWS_S3_BUCKET_NAME=uploads
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
GUNICORN_WORKERS=2
GHCR_USER=CHANGE_ME_GITHUB_USERNAME
GHCR_TOKEN=CHANGE_ME_READ_PACKAGES_TOKEN
